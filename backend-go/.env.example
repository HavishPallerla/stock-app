# Supabase — service role key only, never expose this to the frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# Haiku by default: fast + cheap, keeps the pipeline's per-tweet latency budget.
# Swap to a Sonnet model if signal quality matters more than latency/cost.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Twilio (only required if FEATURE_SMS_ALERTS=true)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Feature flags
FEATURE_SMS_ALERTS=false   # keep off in dev to avoid SMS costs
FEATURE_LIVE_FEED=false    # false = bundled mock fixture, true = real RSS feeds below

# Comma-separated RSS feed URLs, only used when FEATURE_LIVE_FEED=true
FEED_URLS=https://feeds.reuters.com/reuters/businessNews,https://feeds.a.dj.com/rss/RSSMarketsMain.xml

FEED_POLL_INTERVAL_SECONDS=30
ANALYSIS_WORKERS=4
PORT=8090
